{
  "name": "compressed-size-action",
  "version": "2.10.0",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node24 --format=cjs --minify --define:navigator={} --outfile=index.js",
    "test": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "^1.2.6",
    "@actions/exec": "^1.0.4",
    "@actions/github": "^4.0.0",
    "@rschristian/size-plugin": "^0.1.0",
    "esbuild": "^0.28.2",
    "pretty-bytes": "^7",
    "vitest": "^4.0.0"
  },
  "prettier": {
    "useTabs": true,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 100,
    "overrides": [
      {
        "files": [
          "*.json"
        ],
        "options": {
          "useTabs": false
        }
      }
    ]
  }
}
